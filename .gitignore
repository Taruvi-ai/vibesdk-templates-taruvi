# ---------------------------------------------------------------------------
# Credentials — NEVER commit any of these.
# Keep this block first so nothing below can accidentally re-include a secret.
# ---------------------------------------------------------------------------
.env
.env.*
.envrc
!.env.example
.dev.vars
.dev.vars.*
.prod.vars
.prod.vars.*
creds.env
creds.*.env
secrets.json
*.pem
*.key
*.p12
*.pfx
id_rsa*
.npmrc
.netrc

# dependencies
node_modules/
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# build output
/build
/development
/originals
/.next/
/out/
/.open-next
dist/
*.tsbuildinfo
next-env.d.ts

# python
__pycache__/
*.py[cod]
.venv/
venv/

# wrangler / cloudflare
.wrangler/
.vercel

# packaging artifacts
# zips/*.zip ARE committed (they are the published R2 artifacts),
# but rollback/backup copies are not.
*.bak
zips/*.bak
zips/*.zip.bak
zipsbuild/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# misc
.DS_Store
Thumbs.db
